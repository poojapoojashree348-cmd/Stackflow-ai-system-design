# ==============================================================================
# StackFlow AI — Comprehensive .gitignore for GitHub
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js
jspm_packages/

# Environment Variables & Secrets (Prevents GitHub Push Protection Blocks)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env*.local
*.env
# Ensure the safe .env.example template is tracked
!.env.example

# Production Build Outputs
dist/
dist-ssr/
build/
out/

# Temporary files, Vite & TypeScript Caches
.eslintcache
.parcel-cache
.turbo
.cache/
.vite/
tmp/
temp/
*.tsbuildinfo

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Unit Test & Coverage
coverage/
.nyc_output/

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

# IDE & Code Editors
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
