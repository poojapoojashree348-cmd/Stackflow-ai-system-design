# ==============================================================================
# StackFlow AI — Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and fill in your actual credentials.
# NOTE: Never commit your actual .env file or real passwords to GitHub!

# Gemini AI API Configuration
GEMINI_API_KEY="your_gemini_api_key_here"
AI_API_KEY="your_gemini_api_key_here"

# Application URL
APP_URL="http://localhost:3000"

# Server configuration
PORT=3000
CLIENT_URL="http://localhost:3000"

# Authentication
JWT_SECRET="your_jwt_secret_key_change_in_production"

# Database (optional external MongoDB connection string; defaults to reliable built-in file-backed store if not provided)
MONGO_URI="mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/stackflow?retryWrites=true&w=majority"

# Email OTP (Nodemailer configuration)
# For Gmail: Use your full email and a 16-character App Password generated at:
# https://myaccount.google.com/apppasswords
EMAIL_USER="your_email@gmail.com"
EMAIL_PASSWORD="your_16_char_app_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE=true
